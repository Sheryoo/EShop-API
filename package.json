{
  "name": "my-e-shop-api",
  "version": "2.0.1",
  "description": "An E-commerce API with Node.js and Prisma",
  "scripts": {
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "format:check": "prettier \"(*.{js,ts,jsx,tsx,json})|(**/*.{js,ts,jsx,tsx,json})\" --check",
    "format:fix": "prettier \"(*.{js,ts,jsx,tsx,json})|(**/*.{js,ts,jsx,tsx,json})\" --write",
    "type:check": "tsc --noEmit",
    "build": "tsc",
    "start": "prisma generate && prisma migrate dev && yarn build && node dist/app.js",
    "develop": "prisma generate && prisma migrate dev && tsc-watch --onSuccess \"node dist/app.js\"",
    "husky": "INIT_HUSKY=1 && husky",
    "prisma": "prisma",
    "prisma-studio": "prisma studio --port 3031"
  },
  "author": "Sheryoo0",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "streamifier": "^0.1.1",
    "stripe": "^17.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "prisma": "^6.8.2",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "engines": {
    "node": ">=18.0.0 <=20.x.x",
    "npm": ">=6.0.0"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
